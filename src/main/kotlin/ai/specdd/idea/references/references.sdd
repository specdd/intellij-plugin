  ./SpecDDPathReferenceExtractor.kt
  ./SpecDDCodeReferenceExtractor.kt
  ./SpecDDSymbolReferenceExtractor.kt
  ./SpecDDPathResolver.kt
  ./SpecDDReferenceTextUpdater.kt
  ./SpecDDPathReference.kt
  ./SpecDDSymbolReference.kt
  ./SpecDDReferencesSearch.kt
  ./SpecDDReferenceRenameHandler.kt
  ./SpecDDPathReferenceProvider.kt
  ./SpecDDPathReferenceContributor.kt
  ./SpecDDPathAnnotator.kt
